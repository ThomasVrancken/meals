{
  "permissions": {
    "allow": [
      "Bash(npm run deploy)",
      "Bash(npm run deploy:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/cloud-session-start.sh\""
          }
        ]
      }
    ]
  }
}
