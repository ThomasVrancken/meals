{
  "name": "two-pans",
  "version": "0.1.0",
  "private": true,
  "description": "Two Pans: personal meal-recommendation PWA (Express API + React client) for lazy two-pan cooking",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm install --include=dev && npm run build",
    "deploy": "gcloud app deploy app.yaml --project mlsd-2026-483513 --quiet",
    "test:api": "node scripts/api-test.js"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "openai": "^7.15.0"
  },
  "author": "Thomas Vrancken",
  "license": "MIT"
}
